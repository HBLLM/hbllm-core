  "license": "GPL-3.0-only",
  "capabilities": [
    "alfworld_observe",
    "alfworld_act",
    "alfworld_plan_task",
    "alfworld_step",
    "alfworld_decompose_instruction"
  ],
  "permissions": ["environment_simulation"]
