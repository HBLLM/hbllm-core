#!/usr/bin/env bash
# Pre-commit hook for HBLLM Core
# Enforces Ruff (lint & format) and Cargo (fmt, check, clippy) quality gates.

set -e

# ANSI Color Codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}==> [pre-commit] Inspecting staged changes...${NC}"

# Find staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}==> [pre-commit] No staged files to check.${NC}"
    exit 0
fi

STAGED_PYTHON=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
STAGED_RUST=$(echo "$STAGED_FILES" | grep -E '(\.rs$|Cargo\.(toml|lock)$)' || true)

FAILED=0

# ── 1. Python Quality Gates (Ruff) ───────────────────────────────────────────
if [ -n "$STAGED_PYTHON" ]; then
    echo -e "${BLUE}==> [pre-commit] Running Ruff linter on staged Python files...${NC}"
    if command -v ruff >/dev/null 2>&1; then
        RUFF_BIN="ruff"
    elif [ -x "venv/bin/ruff" ]; then
        RUFF_BIN="venv/bin/ruff"
    elif [ -x ".venv/bin/ruff" ]; then
        RUFF_BIN=".venv/bin/ruff"
    else
        RUFF_BIN="python3 -m ruff"
    fi

    # Run ruff check on staged files
    if ! echo "$STAGED_PYTHON" | xargs $RUFF_BIN check; then
        echo -e "${RED}❌ [pre-commit] Ruff linting failed! Fix errors or run: ruff check --fix${NC}"
        FAILED=1
    fi

    # Run ruff format check on staged files
    echo -e "${BLUE}==> [pre-commit] Checking formatting with Ruff...${NC}"
    if ! echo "$STAGED_PYTHON" | xargs $RUFF_BIN format --check; then
        echo -e "${RED}❌ [pre-commit] Ruff format check failed! Run: ruff format <files>${NC}"
        FAILED=1
    fi
fi

# ── 2. Rust Quality Gates (Cargo) ────────────────────────────────────────────
if [ -n "$STAGED_RUST" ]; then
    echo -e "${BLUE}==> [pre-commit] Rust changes detected. Running Cargo quality gates...${NC}"
    
    if command -v cargo >/dev/null 2>&1; then
        echo -e "${BLUE}    --> Checking cargo fmt...${NC}"
        if ! cargo fmt --all -- --check; then
            echo -e "${RED}❌ [pre-commit] cargo fmt check failed! Run: cargo fmt --all${NC}"
            FAILED=1
        fi

        echo -e "${BLUE}    --> Checking cargo check --workspace...${NC}"
        if ! cargo check --workspace; then
            echo -e "${RED}❌ [pre-commit] cargo check failed!${NC}"
            FAILED=1
        fi

        echo -e "${BLUE}    --> Checking cargo clippy...${NC}"
        if ! cargo clippy --workspace -- -D warnings; then
            echo -e "${RED}❌ [pre-commit] cargo clippy failed! Fix clippy warnings before committing.${NC}"
            FAILED=1
        fi
    else
        echo -e "${YELLOW}⚠️  [pre-commit] cargo command not found, skipping Rust verification.${NC}"
    fi
fi

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ Pre-commit validation failed. Please fix the issues above.${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

echo -e "${GREEN}✅ [pre-commit] All pre-commit quality checks passed!${NC}"
exit 0
